# Copy to .env (`dudamel new` already did this for you, with a random
# value). Rotate it any time with `dudamel token rotate` — that command
# rewrites this one line in place and leaves the rest of .env untouched.
DUDAMEL_WEB_TOKEN=

# Uncomment and set if you point a tier at Telegram or Anthropic:
# DUDAMEL_TELEGRAM_TOKEN=
# ANTHROPIC_API_KEY=
